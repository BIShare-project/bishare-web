# Base URL of the BIShare API service (file transfer, rooms, telemetry).
# NEXT_PUBLIC_* vars are baked into the client bundle at build time.
# Defaults to https://api.bishare.app when unset.
NEXT_PUBLIC_API_URL=https://api.bishare.app

# The web worker itself needs NO secrets — it only reads D1 (public stats)
# and serves pages. All credentials live in the separate API service.
