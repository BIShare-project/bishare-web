# Base URL of the BIShare API service (file transfer, rooms, telemetry). It is written into the browser's scripts when
# the site is built, and read by the Worker for the Drive's content policy.
# Defaults to https://api.bishare.app when unset.
API_URL=https://api.bishare.app

# The web worker itself needs NO secrets: it only reads D1 (public stats)
# and serves pages. All credentials live in the separate API service.
