{
  "name": "bishare-app",
  "private": true,
  "version": "3.0.0-dev",
  "type": "module",
  "description": "BIShare v3 — unified Next.js app: backend API (Hono) + admin + web on Cloudflare Workers",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:sw && npm run build:hono && next build",
    "build:cloudflare": "npm run build:sw && npm run build:hono && npx @opennextjs/cloudflare build",
    "preview": "npm run build:cloudflare && npx wrangler dev --port 8788",
    "deploy": "npm run build:cloudflare && npx wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "migrate:local": "wrangler d1 migrations apply bishare-cloud --local",
    "migrate:remote": "wrangler d1 migrations apply bishare-cloud --remote",
    "record:golden": "node tools/contract/record.mjs",
    "record:ws": "node tools/contract/ws-record.mjs",
    "build:hono": "node scripts/build-hono-assets.mjs --clean",
    "dev:hono": "node scripts/dev-hono.mjs",
    "test": "vitest run",
    "parity": "esbuild tool/parity/compare.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/parity.mjs --log-level=warning && node node_modules/.cache/parity.mjs",
    "build:sw": "esbuild src/sw/stream-sw.ts --bundle --format=iife --target=es2022 --outfile=public/stream-sw.js --alias:@=./src"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@formatjs/intl-localematcher": "0.8.13",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "framer-motion": "^12.42.2",
    "heic2any": "0.0.4",
    "highlight.js": "11.12.0",
    "hono": "4.13.21",
    "lucide-react": "^1.24.0",
    "marked": "18.1.0",
    "negotiator": "1.0.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.5",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "4.13.6",
    "utif": "3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^5.6.0",
    "vitest": "3.2.4",
    "wrangler": "^4.40.0"
  },
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "not dead"
  ]
}
