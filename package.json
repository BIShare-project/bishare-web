{
  "name": "bishare-web",
  "private": true,
  "version": "3.0.0-dev",
  "type": "module",
  "description": "BIShare website: Hono on Cloudflare Workers, pages built ahead of time",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "npm run build:sw && node --env-file-if-exists=.env scripts/build-assets.mjs --clean && node --env-file-if-exists=.env scripts/build-pages.mjs",
    "deploy": "npm run build && wrangler deploy",
    "build:sw": "esbuild src/sw/stream-sw.ts --bundle --format=iife --target=es2022 --outfile=public/stream-sw.js --alias:@=./src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "parity": "esbuild tool/parity/compare.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/parity.mjs --log-level=warning && node node_modules/.cache/parity.mjs"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.8.13",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "clsx": "^2.1.1",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "heic2any": "0.0.4",
    "highlight.js": "11.12.0",
    "hono": "4.13.21",
    "marked": "18.1.0",
    "negotiator": "1.0.0",
    "tailwind-merge": "^3.6.0",
    "utif": "3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^20",
    "esbuild": "0.28.2",
    "tailwindcss": "^4",
    "typescript": "^5.6.0",
    "vitest": "3.2.4",
    "wrangler": "^4.40.0"
  }
}
