{
  "name": "bishare-app",
  "private": true,
  "version": "3.0.0-dev",
  "type": "module",
  "description": "BIShare v3 — unified Next.js app: backend API (Hono) + admin + web on Cloudflare Workers",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "npx @opennextjs/cloudflare build",
    "preview": "npm run build:cloudflare && npx wrangler dev --port 8788",
    "deploy": "npm run build:cloudflare && npx wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "migrate:local": "wrangler d1 migrations apply bishare-cloud --local",
    "migrate:remote": "wrangler d1 migrations apply bishare-cloud --remote",
    "record:golden": "node tools/contract/record.mjs",
    "record:ws": "node tools/contract/ws-record.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/mdx": "^2.0.14",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.42.2",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "worker-mailer": "^1.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@opennextjs/cloudflare": "^1.18.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^5.6.0",
    "wrangler": "^4.40.0"
  },
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "not dead"
  ]
}
