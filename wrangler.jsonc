{
  // BIShare web: one Worker serving the pages npm run build makes. The API (file
  // transfer, rooms, telemetry) is a SEPARATE service, see API_URL in .env.example.
  //
  // Self-hosting: replace the placeholders, then `npm run deploy`.
  "name": "bishare-web",
  "main": "worker/index.ts",
  "minify": true,
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Your own custom domain(s) — uncomment and set once DNS is on Cloudflare:
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "www.example.com", "custom_domain": true }
  // ],

  "assets": { "directory": "dist/assets", "binding": "ASSETS", "run_worker_first": ["/_p/*", "/offline.html", "/save-bridge.html"], "html_handling": "none" },

  // D1 powers the public /stats page (read-only aggregate counters) and the
  // StatsLiveDO fingerprint poll. Create one with `wrangler d1 create` and
  // paste its id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bishare-web",
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],

  // Realtime stats push — single global Durable Object behind /stats-live.
  "durable_objects": {
    "bindings": [{ "name": "STATS_LIVE_DO", "class_name": "StatsLiveDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatsLiveDO"] }],

  // Workers Logs sampled at 1% (every page view was stored at 100%).
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
